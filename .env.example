# Configure any combination of the providers below - the bot tries them in
# LLM_PROVIDER_ORDER and falls through to the next one if a provider errors
# out or hits its rate limit. At least one must be set.

GEMINI_API_KEY=your-gemini-api-key-here
# Optional. "Flash-Lite" has a much higher free-tier daily request limit than
# plain "Flash" or "Pro" - check exact numbers at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=your-groq-api-key-here
# Optional. Groq's lineup changes often - if this 404s, browse current models
# at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional. Free model slugs rotate/get deprecated fairly often - if this
# starts returning 404s, check https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=minimax/minimax-m3:free

# Optional. Lets the bot send reaction GIFs (via GIPHY search) in addition to
# text. Get a free key at https://developers.giphy.com. If unset, the bot
# never mentions or attempts GIFs.
GIPHY_API_KEY=your-giphy-api-key-here

# Optional. Comma-separated fallback order for generating replies, only
# configured providers are used. Default favors quality/reliability first,
# falling back to the higher-quota but weaker Gemini Flash-Lite tier last.
LLM_PROVIDER_ORDER=groq,openrouter,gemini

# Optional. Comma-separated fallback order for memory extraction. Default puts
# the schema-enforced routes (Groq strict JSON Schema, Gemini schema-constrained
# JSON) before OpenRouter's best-effort JSON Object Mode.
MEMORY_PROVIDER_ORDER=groq,gemini,openrouter

# Optional. If every provider fails in one pass (e.g. a transient rate limit),
# retry the whole chain this many times before giving up on the message.
LLM_RETRY_PASSES=2
# Optional. Delay in ms between retry passes.
LLM_RETRY_DELAY_MS=5000

# Optional. Location of the SQLite database holding conversation messages and
# durable memories. Defaults to ./data/flunkiebot.sqlite, which Docker Compose
# bind-mounts from the host so memory survives rebuilds and restarts.
# Startup fails visibly if this database cannot be opened or migrated.
MEMORY_DB_PATH=./data/flunkiebot.sqlite

# Optional. Lets FlunkieBot start a conversation himself, without being
# addressed first. "off" (the default) means he only ever answers. "dm-only"
# means he may send an unprompted message, but exclusively to people who
# already started a direct-message thread with him themselves. There is no
# mode that messages anyone else.
INITIATIVE_MODE=off

# Optional. Minimum number of days between two unprompted messages to the same
# person. This knob, not the occasion, is what determines the volume.
INITIATIVE_MIN_DAYS=14

# Optional. Maximum number of unprompted messages across the whole group in any
# rolling seven-day window.
INITIATIVE_WEEKLY_CAP=2

# Optional. The hours of the day, local time, in which an unprompted message
# may go out. Written as "<start>-<end>", end exclusive. Set TZ as well if the
# container is not already in your group's timezone.
INITIATIVE_HOURS=10-23

# Optional. A container runs in UTC unless you say otherwise, and
# INITIATIVE_HOURS is read in that timezone. Uncomment before switching
# unprompted messages on, or the window sits in the wrong part of the day.
# TZ=Europe/Amsterdam

# Optional. Comma-separated phone numbers that never receive an unprompted
# message, whatever the mode says. Spaces, plus signs and dashes are ignored,
# so "+31 6 12345678" and "31612345678" are the same entry.
INITIATIVE_EXCLUDED_NUMBERS=

# Optional. Controls app log verbosity: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# Optional. Controls verbosity of Baileys' own internal logger
BAILEYS_LOG_LEVEL=warn
# Optional. Logs are human-readable by default; set to "json" for raw
# structured JSON (e.g. if you're piping logs into a log aggregator).
LOG_FORMAT=pretty
